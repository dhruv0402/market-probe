# ==============================================================================
# MarketProbe Environment Configuration Template
# Copy this file to .env and populate real secrets (NEVER commit .env!)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY
# ------------------------------------------------------------------------------
ENV=development
PORT=8080
MARKETPROBE_SECRET_KEY=replace_with_openssl_rand_hex_32
CORS_ORIGINS=http://localhost:8080
MARKETPROBE_ALLOW_DEMO_TOKEN=true
MARKETPROBE_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. AI & LLM ORCHESTRATOR (Google AI Studio / Gemini API)
# Obtain from: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. DATABASE & CACHE (PostgreSQL in Production, SQLite Fallback Locally)
# ------------------------------------------------------------------------------
# Leave DATABASE_URL blank locally to use SQLite; set postgresql://... in prod
DATABASE_URL=
REDIS_URL=
MARKETPROBE_DB_PATH=data/marketprobe.db
MARKETPROBE_MODEL_PATH=data/xgb_model.pkl

# ------------------------------------------------------------------------------
# 4. OPTIONAL OFFICIAL INDIAN BROKER MARKET DATA FEEDS (Priority over yfinance)
# ------------------------------------------------------------------------------
# Option A: Dhan HQ v2 (https://dhanhq.co/)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Option B: Zerodha Kite Connect v3 (https://kite.trade/)
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. BILLING & PAYMENTS (Optional — Razorpay for INR / Stripe for Global USD)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=
STRIPE_PUBLISHABLE_KEY=pk_test_yourStripePublishableKey
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
