# ==============================================================================
# MarketProbe Environment Configuration Template
# Copy this file to .env and populate your actual secrets for live production
# ==============================================================================

# Core Application Settings
PORT=8080
MARKETPROBE_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_hex_key
CORS_ORIGINS=*

# Database & Storage
MARKETPROBE_DB_PATH=data/marketprobe.db
MARKETPROBE_MODEL_PATH=data/xgb_model.pkl

# ------------------------------------------------------------------------------
# 1. RAZORPAY CONFIGURATION (For Indian UPI, RuPay, Cards & NetBanking)
# Obtain from: https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
# Public API Key (Sent to the frontend to render the Razorpay modal)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere

# Private Secret Key (Used on the backend to verify the cryptographic HMAC signature)
RAZORPAY_KEY_SECRET=yourRazorpaySecretKeyHere

# ------------------------------------------------------------------------------
# 2. STRIPE CONFIGURATION (For Global USD & International Subscriptions)
# Obtain from: https://dashboard.stripe.com/apikeys & https://dashboard.stripe.com/webhooks
# ------------------------------------------------------------------------------
# Publishable Key (Sent to frontend for Stripe Elements / Checkout)
STRIPE_PUBLISHABLE_KEY=pk_test_yourStripePublishableKey

# Secret Key (Used for server-to-server calls)
STRIPE_SECRET_KEY=sk_test_yourStripeSecretKey

# Webhook Endpoint Secret (Used to verify incoming Stripe webhook signatures)
STRIPE_WEBHOOK_SECRET=whsec_yourStripeWebhookSecretHere

# ------------------------------------------------------------------------------
# 3. PROXY SETTINGS (Optional: Residential Proxies for Large Scale Web Crawling)
# ------------------------------------------------------------------------------
# PROXY_URL=http://user:password@residential-proxy-node.com:8000
